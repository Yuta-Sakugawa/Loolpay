@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IEnumerable<Loolpay.Models.Store>
@{
    ViewData["Title"] = Localizer["Home Page"];
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4">@Localizer["Stores"]</h1>
        <div class="d-flex gap-2">
            <form asp-action="Index" method="get" class="d-flex">
                <input type="text" name="SearchString" class="form-control me-2" placeholder="@Localizer["Search stores..."]" />
                <button type="submit" class="btn btn-outline-primary">@Localizer["Search"]</button>
            </form>
            <a asp-action="Create" class="btn btn-success">@Localizer["Add New Store"]</a>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>@Localizer["Store Name"]</th>
                <th>@Localizer["Address"]</th>
                <th>@Localizer["Payment Methods"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var store in Model)
            {
                <tr>
                    <td>@store.StoreId</td>
                    <td>@store.StoreName</td>
                    <td>@store.StoreAddress</td>
                    <td>@store.Pay</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a asp-action="Edit" asp-route-id="@store.StoreId" class="btn btn-sm btn-primary">@Localizer["Edit"]</a>
                            <form asp-action="Delete" asp-route-id="@store.StoreId" method="post" onsubmit="return confirm('@Localizer["Are you sure you want to delete this store?"]');" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger">@Localizer["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
