>>>>>>> main
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                        <i class="bi bi-shield-lock"></i> @Localizer["Privacy"]
                    </a>
                </nav>
            </div>

            <div>
                <hr>
                <div class="dropdown mb-3">
                    <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-translate"></i> @Localizer["Language"]
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="languageDropdown">
                        <li>
                            <form asp-controller="Language" asp-action="SetLanguage" method="post" class="px-3 py-1">
                                <input type="hidden" name="culture" value="ja" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="dropdown-item p-0">日本語</button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Language" asp-action="SetLanguage" method="post" class="px-3 py-1">
                                <input type="hidden" name="culture" value="en" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="dropdown-item p-0">English</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </aside>

        <div class="main-content">

            <header class="top-navbar border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <main role="main" class="content-body">

                @RenderBody()

            </main>

            <footer class="footer mt-auto py-3 bg-white border-top text-center text-muted">
                <div class="container-fluid">
                    <span>&copy; 2026 - Loolpay</span>
                </div>
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

   

</body>
</html>