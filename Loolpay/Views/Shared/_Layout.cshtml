@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Loolpay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Loolpay.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            /* --------------------------------------------------
                     * サイドバー固定用のカスタムCSS（後で site.css に移してもOK）
                     * -------------------------------------------------- */
            body {
                background-color: #f8f9fa; /* 薄いグレーの背景 */
            }

            .wrapper {
                display: flex;
                min-height: 100vh;
            }
            /* 固定サイドバー */
            .sidebar {
                width: 260px;
                min-width: 260px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background-color: #ffffff;
                border-right: 1px solid #e9ecef;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 2rem 1.5rem;
                z-index: 1000;
            }
            /* 右側のメインエリア */
            .main-content {
                flex-grow: 1;
                margin-left: 260px; /* サイドバーの幅分だけ空ける */
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }
            /* 上部ミニヘッダー */
            .top-navbar {
                height: 70px;
                background-color: #ffffff;
                padding: 0 2rem;
                display: flex;
                align-items: center;
                justify-content: flex-end; /* 右寄せ */
            }
            /* コンテンツのパディング */
            .content-body {
                padding: 2rem;
                flex-grow: 1;
            }
            /* ナビゲーションリンクのスタイル調整 */
            .sidebar .nav-link {
                color: #495057;
                padding: 0.8rem 1rem;
                border-radius: 0.5rem;
                margin-bottom: 0.25rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                text-decoration: none;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background-color: #f1f3f5;
                    color: #0d6efd;
                }
    </style>

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

</head>
<body>

    <div class="wrapper">
        <aside class="sidebar">
            <div>
                <div class="mb-4 px-2">
                    <a class="navbar-brand fs-3 fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-wallet2 me-2"></i>Loolpay
                    </a>
                </div>

                <nav class="nav flex-column">
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i> @Localizer["Home"]
                    </a>
                    <a class="nav-link" asp-area="" asp-controller="Places" asp-action="Index">
                        <i class="bi bi-geo-alt"></i> @Localizer["Stores"]
                    </a>
<<<<<<< HEAD
                    <a class="nav-link" asp-area="" asp-controller="Favorites" asp-action="Index">
                        <i class="bi bi-heart"></i> お気に入り
                    </a>
