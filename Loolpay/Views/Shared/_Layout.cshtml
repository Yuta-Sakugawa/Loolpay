                    {
                        <a class="nav-link" asp-controller="Admin" asp-action="Logs">
                            <i class="bi bi-file-earmark-text"></i> 閲覧ログ
                        </a>
                        <a class="nav-link" asp-controller="Admin" asp-action="Rankings">
                            <i class="bi bi-graph-up"></i> 人気ランキング
                        </a>
