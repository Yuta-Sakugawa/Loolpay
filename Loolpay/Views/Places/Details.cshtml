@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Loolpay.Models.Store

@{
    ViewData["Title"] = Localizer["Store Details"];
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">@Localizer["Store Details"]</h3>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var isFavorite = (bool)ViewBag.IsFavorite;
                        <button type="button" class="btn btn-link text-white" onclick="toggleFavorite(@Model.StoreId, this)">
                            <i class="bi @(isFavorite ? "bi-heart-fill text-danger" : "bi-heart") fs-3"></i>
                        </button>
                    }
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-12 text-center">
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <img src="~/images/stores/@Model.ImagePath" class="img-fluid rounded shadow-sm" style="max-height: 300px;" alt="@Model.StoreName" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 200px; border: 2px dashed #dee2e6;">
                                    <span class="text-muted">@Localizer["No photo available"]</span>
                                </div>
                            }
                        </div>
                    </div>
                    <dl class="row">
                        <dt class="col-sm-3">@Localizer["Store Name"]</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.StoreName)</dd>

                        <dt class="col-sm-3">@Localizer["Genre"]</dt>
                        <dd class="col-sm-9">@Localizer[Model.Genre.ToString()]</dd>

                        <dt class="col-sm-3">@Localizer["Address"]</dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.StoreAddress)
                            <div id="map" style="height:300px;" class="border rounded mt-2"></div>
                        </dd>

                        <dt class="col-sm-3">@Localizer["Payment Methods"]</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.Pay))
                            {
                                @foreach (var payment in Model.Pay.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-light text-primary border border-primary">@Localizer[payment.Trim()]</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">@Localizer["No payment methods listed"]</span>
                            }
                        </dd>

                        <dt class="col-sm-3">@Localizer["Last Updated"]</dt>
                        <dd class="col-sm-9">@Model.LastUpdated.ToString("yyyy/MM/dd HH:mm")</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">@Localizer["Back to List"]</a>
                    @if (User.IsInRole("admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.StoreId" class="btn btn-primary">@Localizer["Edit"]</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        console.log("Details script loaded");
        document.addEventListener('DOMContentLoaded', async function () {
            console.log("DOMContentLoaded fired");
            const address = '@Model.StoreAddress';
            console.log("Address being used:", address);
            
            const mapContainer = document.getElementById('map');
            if (!mapContainer) {
                console.error("Map container not found!");
                return;
            }
            if (!address) {
                console.log("No address provided");
                return;
            }

            // 確実なマーカーアイコン設定
            const customIcon = L.icon({
                iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon.png',
                iconRetinaUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon-2x.png',
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });
            console.log("Icon defined");

            const map = L.map('map').setView([0, 0], 13);
            console.log("Map initialized");
            
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);
            console.log("Tile layer added");

            try {
                console.log("Fetching coordinates...");
                const response = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(address)}&format=json&limit=1`);
                const data = await response.json();
                console.log("Response received:", data);
                
                if (data.length > 0) {
                    const lat = data[0].lat;
                    const lon = data[0].lon;
                    console.log("Coordinates found:", lat, lon);
                    map.setView([lat, lon], 13);
                    
                    // アイコンを指定してマーカー作成
                    const marker = L.marker([lat, lon], { icon: customIcon }).addTo(map).bindPopup('@Model.StoreName').openPopup();
                    console.log("Marker added");
                } else {
                    console.warn("No coordinates found for address:", address);
                }
            } catch (err) {
                console.error("Map error during fetch/marker:", err);
            }
        });
    </script>
}
