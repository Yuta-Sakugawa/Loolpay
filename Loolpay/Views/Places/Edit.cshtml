@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Loolpay.Models.Store

@{
    ViewData["Title"] = Localizer["Edit Store"];
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">@Localizer["Edit Store"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="StoreId" />
                        <input type="hidden" asp-for="ImagePath" />
                        <div class="mb-3">
                            <label asp-for="StoreName" class="form-label">@Localizer["Store Name"]</label>
                            <input asp-for="StoreName" class="form-control" />
                            <span asp-validation-for="StoreName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="StoreAddress" class="form-label">@Localizer["Address"]</label>
                            <input asp-for="StoreAddress" class="form-control" />
                            <span asp-validation-for="StoreAddress" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Genre" class="form-label">@Localizer["Genre"]</label>
                            <select asp-for="Genre" asp-items="Html.GetEnumSelectList<Loolpay.Models.StoreGenre>()" class="form-control">
                                <option value="">@Localizer["Select Genre"]</option>
                            </select>
                            <span asp-validation-for="Genre" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Current Photo"]</label>
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <div class="mb-2">
                                    <img src="~/images/stores/@Model.ImagePath" class="img-thumbnail" style="max-width: 200px;" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">@Localizer["No photo available."]</p>
                            }
                            <label class="form-label mt-2">@Localizer["Photo Edit"]</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["Payment Methods"]</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedPaymentMethods" value="Cash" id="payCash" @(Model.SelectedPaymentMethods.Contains("Cash") ? "checked" : "")>
                                <label class="form-check-label" for="payCash">@Localizer["Cash"]</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedPaymentMethods" value="Credit Card" id="payCredit" @(Model.SelectedPaymentMethods.Contains("Credit Card") ? "checked" : "")>
                                <label class="form-check-label" for="payCredit">@Localizer["Credit Card"]</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedPaymentMethods" value="QR Payment" id="payQR" @(Model.SelectedPaymentMethods.Contains("QR Payment") ? "checked" : "")>
                                <label class="form-check-label" for="payQR">@Localizer["QR Payment"]</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedPaymentMethods" value="Prepaid Card" id="payPrepaid" @(Model.SelectedPaymentMethods.Contains("Prepaid Card") ? "checked" : "")>
                                <label class="form-check-label" for="payPrepaid">@Localizer["Prepaid Card"]</label>
                            </div>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary">@Localizer["Cancel"]</a>
                            <button type="submit" class="btn btn-primary">@Localizer["Save Changes"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
